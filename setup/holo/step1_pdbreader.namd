paratypecharmm          on

# output
set output              /adhome/o/og/ogundero/charmm_holoo/charmm-gui-7030301414/step1_pdbreader
outputname              $output
dcdfile                 ${output}.dcd
xstFile                 ${output}.xst
dcdfreq                 50
